# Application Settings
ENVIRONMENT=development
APP_NAME="Distributed Job Scheduling Platform"
DEBUG=true
LOG_LEVEL=INFO

# API Server
API_HOST=0.0.0.0
API_PORT=8000

# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=job_scheduler
# Async connection URL used by the application
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/job_scheduler
# Sync connection URL used by Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/job_scheduler

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# Scheduler Settings
SCHEDULER_POLL_INTERVAL_SECONDS=1.0
SCHEDULER_BATCH_SIZE=50
SCHEDULER_LOCK_TIMEOUT_SECONDS=10.0

# Worker Settings
WORKER_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_SECONDS=15.0
WORKER_DEFAULT_TIMEOUT_SECONDS=300
WORKER_QUEUE_WAIT_TIMEOUT_SECONDS=2.0

# Recovery & Reliability Settings
RECOVERY_POLL_INTERVAL_SECONDS=10.0
RECOVERY_LEASE_GRACE_PERIOD_SECONDS=10.0
RECONCILIATION_INTERVAL_SECONDS=30.0
DEFAULT_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=300.0
RETRY_JITTER=true
